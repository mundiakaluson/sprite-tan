class_name PixelUi
## Helpers for the pixel HUD (art generated by hud/hudlib.py into assets/ui/, same language as the cards). Everything is drawn at whole pixels, 1:1.

const MARGIN := 4                       ## nine-patch margin of ui/panel.png and the ui/button_*.png images (16x16)
const STEEL := Color(0.62, 0.66, 0.8)   ## default accent: the near-white frame pixels are multiplied by it

## draws a nine-patch frame (corners fixed, edges and middle stretched) into r, whole pixels only; tint multiplies the whole image (frame pixels are near white)
static func nine(ci: CanvasItem, r: Rect2, tex: Texture2D, tint := Color.WHITE) -> void:
	if tex == null: return
	var m := MARGIN
	var x0 := roundi(r.position.x)
	var y0 := roundi(r.position.y)
	var w := roundi(r.size.x)
	var h := roundi(r.size.y)
	var t := tex.get_width()
	var xs := [[0, m, x0, m], [m, t - m, x0 + m, w - 2 * m], [t - m, t, x0 + w - m, m]]
	var ys := [[0, m, y0, m], [m, t - m, y0 + m, h - 2 * m], [t - m, t, y0 + h - m, m]]
	for yy in ys:
		for xx in xs:
			if xx[3] <= 0 or yy[3] <= 0: continue
			ci.draw_texture_rect_region(tex, Rect2(xx[2], yy[2], xx[3], yy[3]), Rect2(xx[0], yy[0], xx[1] - xx[0], yy[1] - yy[0]), tint)

static func tex(name: String) -> Texture2D:
	return Data.tex("ui/%s.png" % name)
