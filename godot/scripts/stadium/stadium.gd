@tool
class_name Stadium
extends Node2D
## A stadium: backdrop (pitch + boards + stands + crowd), goals and corner flags. Art is generated by the export into
## res://assets/pitches/<stadium_id>/ (data/stadiums.csv). Set stadium_id in the inspector to switch.
## Pitch coordinates (x 0-100 left to right, y 0-100 own goal to opponent goal): pitch_to_screen() gives the pixel in this node.
## TV view: the pitch runs left to right, own goal on the left, attack to the right. Pitch x 0-100 is the touchline (0 = top of the screen),
## pitch y 0-100 is own goal to opponent goal. Players go in the Actors node (y-sorted). The Camera follows `follow` (a Node2D, e.g. the ball) along the pitch.

@export var stadium_id := "ST01":
	set(v):
		stadium_id = v
		if is_node_ready(): rebuild()

@onready var backdrop: Sprite2D = $Backdrop
@onready var goal_back_l: Sprite2D = $GoalBackL
@onready var goal_back_r: Sprite2D = $GoalBackR
@onready var goal_front_l: Sprite2D = $GoalFrontL
@onready var goal_front_r: Sprite2D = $GoalFrontR
@onready var camera: Camera2D = $Camera
## what the camera follows (ball or a player); leave empty to look at the middle of the pitch
@export var follow: Node2D
@onready var flags: Node2D = $Flags
@onready var actors: Node2D = $Actors

var layout := {}

func _ready() -> void:
	rebuild()

func _load_json(path: String) -> Variant:
	if not FileAccess.file_exists(path): return null
	return JSON.parse_string(FileAccess.get_file_as_string(path))

func _tex(path: String) -> Texture2D:
	if ResourceLoader.exists(path):
		var t = load(path)
		if t is Texture2D: return t
	if FileAccess.file_exists(path):
		var img := Image.load_from_file(ProjectSettings.globalize_path(path))
		if img != null: return ImageTexture.create_from_image(img)
	return null

func rebuild() -> void:
	var dir := "res://assets/pitches/%s/" % stadium_id
	var l = _load_json(dir + "layout.json")
	if l == null:
		push_warning("Stadium: no art for '%s' (run Export to game)" % stadium_id)
		return
	layout = l
	backdrop.texture = _tex(dir + "backdrop.png"); backdrop.centered = false; backdrop.position = Vector2.ZERO
	var gb := _tex(dir + "goal_back.png"); var gf := _tex(dir + "goal_front.png")
	_place_goal(goal_back_l, gb, layout["goal_left"]); _place_goal(goal_front_l, gf, layout["goal_left"])
	_place_goal(goal_back_r, gb, layout["goal_right"]); _place_goal(goal_front_r, gf, layout["goal_right"])
	var cs := canvas_size()
	camera.limit_left = 0; camera.limit_top = 0; camera.limit_right = int(cs.x); camera.limit_bottom = int(cs.y)
	camera.position = pitch_to_screen(Vector2(50, 50))
	for c in flags.get_children(): c.queue_free()
	var ft := _tex(dir + "corner_flag.png")
	var fo = layout["flag"]["origin"]
	for p in layout["flag"]["corners"]:
		var s := Sprite2D.new(); s.texture = ft; s.centered = false
		s.position = Vector2(p[0] - fo[0], p[1] - fo[1]); flags.add_child(s)

func _place_goal(s: Sprite2D, t: Texture2D, g: Dictionary) -> void:
	s.texture = t; s.centered = false
	var flip: bool = g.get("flip", false)
	s.flip_h = flip
	var ox: float = g["origin"][0]
	if flip and t != null: ox = t.get_width() - ox
	s.position = Vector2(g["pos"][0] - ox, g["pos"][1] - g["origin"][1])

func _process(_dt: float) -> void:
	if follow != null and not Engine.is_editor_hint(): camera.position.x = follow.position.x

## pitch coordinates (x 0-100 across, y 0-100 own goal to opponent goal) -> pixel in this node
func pitch_to_screen(p: Vector2) -> Vector2:
	if layout.is_empty(): return Vector2.ZERO
	var o = layout["pitch_origin"]; var s = layout["pitch_size"]
	return Vector2(o[0] + p.y / 100.0 * s[0], o[1] + p.x / 100.0 * s[1])

func screen_to_pitch(px: Vector2) -> Vector2:
	if layout.is_empty(): return Vector2.ZERO
	var o = layout["pitch_origin"]; var s = layout["pitch_size"]
	return Vector2((px.y - o[1]) / s[1] * 100.0, (px.x - o[0]) / s[0] * 100.0)

func canvas_size() -> Vector2:
	return Vector2(layout["canvas"][0], layout["canvas"][1]) if not layout.is_empty() else Vector2(960, 540)
