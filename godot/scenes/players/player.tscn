[gd_scene load_steps=10 format=3]

[ext_resource type="Script" path="res://scripts/players/player.gd" id="1"]
[ext_resource type="Script" path="res://scripts/players/player_sprite.gd" id="2"]
[ext_resource type="Script" path="res://scripts/players/state_machine.gd" id="3"]
[ext_resource type="Script" path="res://scripts/players/player_state.gd" id="4"]
[ext_resource type="Script" path="res://scripts/players/states/state_run.gd" id="5"]
[ext_resource type="Script" path="res://scripts/players/states/state_action.gd" id="6"]
[ext_resource type="Script" path="res://scripts/players/states/state_timed.gd" id="7"]
[ext_resource type="AnimationLibrary" path="res://animations/player_library.tres" id="8"]
[ext_resource type="AnimationNodeStateMachine" path="res://animations/player_flow.tres" id="9"]

[node name="Player" type="Node2D"]
script = ExtResource("1")

[node name="Sprite" type="Sprite2D" parent="."]
script = ExtResource("2")

[node name="AnimationPlayer" type="AnimationPlayer" parent="."]
libraries = {
&"": ExtResource("8")
}

[node name="AnimationTree" type="AnimationTree" parent="."]
tree_root = ExtResource("9")
anim_player = NodePath("../AnimationPlayer")

[node name="StateMachine" type="Node" parent="."]
script = ExtResource("3")
initial_state = NodePath("Idle")

[node name="Idle" type="Node" parent="StateMachine"]
script = ExtResource("4")
clip = "base_idle"
event_transitions = {
"move_to": "Run",
"play_action": "Action",
"stun": "Stunned"
}

[node name="Run" type="Node" parent="StateMachine"]
script = ExtResource("5")
clip = "run"
stop_movement = false
event_transitions = {
"play_action": "Action",
"stun": "Stunned"
}

[node name="Action" type="Node" parent="StateMachine"]
script = ExtResource("6")
go_to_when_clip_ends = &"Idle"

[node name="Stunned" type="Node" parent="StateMachine"]
script = ExtResource("7")
clip = "base_stun"
duration = 1.2
then_go_to = &"Idle"
